# Reference for later auth/DB work. The skeleton does not read these variables.
# Never commit a real .env. Generate a random JWT secret when implementing auth.
DATABASE_URL=sqlite:///./data/matchmate.db
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SQLITE_BUSY_TIMEOUT_MS=5000
LOG_LEVEL=INFO
DEFAULT_SEARCH_RADIUS_KM=5
