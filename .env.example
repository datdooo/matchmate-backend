# Ví dụ cấu hình môi trường; tạo JWT secret bằng python -m scripts.init_env.
# Khi đổi DB, seed và app phải dùng cùng DATABASE_URL từ environment.
DATABASE_URL=sqlite:///./data/matchmate.db
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SQLITE_BUSY_TIMEOUT_MS=5000
LOG_LEVEL=INFO
