  "components": {
    "schemas": {
      "CreateSessionRequest": {
        "properties": {
          "venue_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Venue Id"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title"
          },
          "notes": {
            "type": "string",
            "maxLength": 1000,
            "title": "Notes",
            "default": ""
          },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "title": "Starts At"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ends At"
          },
          "play_type": {
            "type": "string",
            "enum": [
              "SINGLES",
              "DOUBLES"
            ],
            "title": "Play Type"
          },
          "fee_male_vnd": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Fee Male Vnd"
          },
          "fee_female_vnd": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Fee Female Vnd"
          },
          "min_level": {
            "$ref": "#/components/schemas/SkillLevel"
          },
          "max_level": {
            "$ref": "#/components/schemas/SkillLevel"
          },
          "gender_policy": {
            "type": "string",
            "enum": [
              "ANY",
              "MALE_ONLY",
              "FEMALE_ONLY"
            ],
            "title": "Gender Policy",
            "default": "ANY"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "venue_id",
          "title",
          "starts_at",
          "ends_at",
          "play_type",
          "fee_male_vnd",
          "fee_female_vnd",
          "min_level",
          "max_level"
        ],
        "title": "CreateSessionRequest"
      },
      "DecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ],
            "title": "Decision"
