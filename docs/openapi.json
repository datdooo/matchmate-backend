        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Gender": {
        "type": "string",
        "enum": [
          "MALE",
          "FEMALE",
          "UNSPECIFIED"
        ],
        "title": "Gender"
      },
      "GenderPolicy": {
        "type": "string",
        "enum": [
          "ANY",
          "MALE_ONLY",
          "FEMALE_ONLY"
        ],
