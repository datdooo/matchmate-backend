        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "DecisionRequest"
      },
      "DisplayStatus": {
        "type": "string",
        "enum": [
          "CANCELLED",
          "ENDED",
          "STARTED",
          "FULL",
          "AVAILABLE"
        ],
        "title": "DisplayStatus"
      },
      "ErrorPayload": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "details",
